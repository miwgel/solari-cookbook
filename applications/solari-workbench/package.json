{
  "name": "solari-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recoverable debugging handoffs for agents in SSH workspaces",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "bin": {
    "workbench": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "tsx src/cli.ts serve --provider fake",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "playwright test",
    "test:live": "tsx scripts/live.ts",
    "demo:scripted": "tsx scripts/demo.ts",
    "privacy:check": "node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "11.3.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@novnc/novnc": "1.7.0",
    "@solarisdk/desktop": "0.1.3",
    "@solarisdk/sandbox": "0.1.4",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "fastify": "5.12.5",
    "lucide-react": "1.49.0",
    "picomatch": "4.0.7",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/picomatch": "4.0.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
