# The offline demo requires no environment variables.
# Optional live provider credential. Store the real value outside Git.
SOLARI_API_KEY=

# Live tests are disabled unless explicitly set to 1.
WORKBENCH_LIVE=0

# Optional application paths. Leaving these unset uses private defaults.
# WORKBENCH_STATE_DIR=/path/to/private/workbench-state
# WORKBENCH_DEMO_OUTPUT=/path/to/private/demo-evidence
# XDG_STATE_HOME=/path/to/private/state

# WORKBENCH_RUNTIME, WORKBENCH_ARTIFACTS, and WORKBENCH_RUN_MARKER
# are supplied by Workbench to guest processes; do not configure them here.
